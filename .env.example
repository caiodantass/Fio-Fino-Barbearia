# ───────── Servidor ─────────
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
DB_PATH=./data/fiofino.db
TZ_BARBEARIA=America/Fortaleza

# ───────── Regras de agenda ─────────
SLOT_MINUTOS=60
JANELA_DIAS=30
ANTECEDENCIA_MIN_MINUTOS=30
MAX_AGENDAMENTOS_FUTUROS_POR_CLIENTE=3

# ───────── Segurança ─────────
ADMIN_TOKEN=troque-este-token-admin
INTERNAL_API_TOKEN=troque-este-token-interno

# ───────── WhatsApp Cloud API (Meta) ─────────
WA_VERIFY_TOKEN=token-de-verificacao-do-webhook
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0

# ───────── LLM ─────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
