{
  "name": "fio-fino-barbearia",
  "version": "1.0.0",
  "description": "Ecossistema Fio Fino Barbearia: site de agendamento, secretária virtual via WhatsApp (IA) e módulo administrativo.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/db/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/db/reset.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
